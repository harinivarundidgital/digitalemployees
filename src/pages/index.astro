---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import AgentTerminalMockup from '../components/AgentTerminalMockup.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Digital Employees | Autonomous AI Workforce Platform (digitalemployees.us)">
	<!-- Top Navigation Menu Bar -->
	<Navbar />

	<main id="main-content">
		<!-- Hero Section with Interactive 3D Mesh Canvas -->
		<HeroSection />

		<!-- Agent Execution Engine Terminal Section -->
		<section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
			<div class="text-center mb-10">
				<h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-[#171717]">
					Autonomous Execution Engine
				</h2>
				<p class="mt-3 text-sm sm:text-base text-gray-500 max-w-xl mx-auto">
					Watch your digital employees analyze, test, and deploy code in real time.
				</p>
			</div>
			<AgentTerminalMockup />
		</section>
	</main>

	<!-- Footer -->
	<Footer />
</Layout>
