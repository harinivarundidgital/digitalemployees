---
// HeroSection.astro - Interactive 100vh Scroll-Driven AI Workforce Storytelling Hero
// Each service has a dedicated theme color and alternates left/right around sticky Hero Image.
// Step 1: LEFT (Emerald Green)
// Step 2: RIGHT (Electric Blue)
// Step 3: LEFT (Deep Purple)
// Step 4: RIGHT (Warm Amber) + Video Demo Playbox
---

<section id="hero-scroll-wrapper" class="relative w-full h-[500vh] bg-white select-none">
  
  <!-- PINNED STICKY VIEWPORT CONTAINER (Sticks to top during 500vh scroll) -->
  <div 
    id="hero-sticky-viewport" 
    class="sticky top-0 w-full h-screen overflow-hidden flex flex-col justify-between items-center pt-16 sm:pt-20 pb-0 px-4 sm:px-6 lg:px-8 z-20"
  >
    
    <!-- VERCEL SIGNATURE UNIFIED BACKGROUND (Grid + Mesh Glow + Watermark) -->
    <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Vercel Grid Pattern -->
      <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
      <!-- Ambient Mesh Glow -->
      <div id="hero-mesh-glow" class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] sm:w-[1100px] h-[480px] vercel-mesh-gradient opacity-35 rounded-full filter blur-[60px]"></div>
      
      <!-- DIGITAL EMPLOYEES LOW OPACITY WATERMARK -->
      <div id="hero-watermark" class="absolute top-[46%] sm:top-[48%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-full flex flex-col items-center justify-center pointer-events-none select-none opacity-[0.035] sm:opacity-[0.045] px-4 overflow-hidden">
        <span class="block text-[14vw] sm:text-[12vw] md:text-[10vw] lg:text-[9.5vw] font-black uppercase tracking-tighter sm:tracking-normal text-black leading-[0.82] text-center max-w-full">
          Digital
        </span>
        <span class="block text-[14vw] sm:text-[12vw] md:text-[10vw] lg:text-[9.5vw] font-black uppercase tracking-tighter sm:tracking-normal text-black leading-[0.82] text-center max-w-full">
          Employees
        </span>
      </div>

      <!-- Linear Fade to White at Bottom -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white pointer-events-none"></div>
    </div>

    <!-- 0. INITIAL HEADER TEXT (Centerstage Heading - Fades & Drifts Up on Scroll) -->
    <div id="hero-header-text" class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center text-center pointer-events-none mb-2 sm:mb-4">
      <h1 
        id="hero-heading" 
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.08] max-w-4xl mx-auto text-gray-500"
      >
        <span class="block text-gray-500">Meet the AI Workforce</span>
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-gray-400 via-gray-500 to-gray-600">
          That Never Stops Working
        </span>
      </h1>

      <p 
        id="hero-desc" 
        class="mt-2.5 sm:mt-3.5 text-sm sm:text-base md:text-lg text-gray-500 max-w-[620px] mx-auto font-medium tracking-tight leading-relaxed"
      >
        Intelligent AI employees that chat, call and automate your business 24/7.
      </p>
    </div>

    <!-- HERO IMAGE (STICKY ANCHORED AT BOTTOM OF THE SECTION) -->
    <div id="hero-avatar-wrapper" class="absolute bottom-0 left-1/2 -translate-x-1/2 z-10 w-full max-w-3xl flex items-end justify-center pointer-events-auto">
      <div id="hero-avatar-container" class="relative z-10 w-full flex items-end justify-center">
        <img 
          id="hero-avatar-image"
          src="/Herosection-image.png" 
          alt="Digital Employees Autonomous AI Workforce Platform" 
          class="w-auto max-w-[85%] sm:max-w-full h-auto max-h-[50vh] sm:max-h-[58vh] object-contain drop-shadow-[0_25px_50px_rgba(0,0,0,0.16)] select-none transition-transform duration-300 ease-out"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <!-- SCROLL-DRIVEN ALTERNATING LEFT/RIGHT CONTENT CARDS OVERLAY -->
    <div class="absolute inset-0 z-40 pointer-events-none flex items-center justify-center max-w-[1400px] mx-auto px-3 sm:px-6 lg:px-8">
      
      <!-- STAGE 1: AI CHATBOT AVATARS (LEFT SIDE - EMERALD GREEN THEME) -->
      <div 
        id="scroll-stage-1" 
        class="absolute left-3 sm:left-6 lg:left-10 top-[38%] sm:top-[42%] md:top-[45%] -translate-y-1/2 max-w-[290px] sm:max-w-[350px] md:max-w-[380px] w-full pointer-events-auto transition-all duration-300"
        style="opacity: 0; transform: translateY(40px);"
      >
        <div class="p-4 sm:p-6 bg-white/95 backdrop-blur-xl rounded-2xl border border-emerald-200/90 shadow-[0_20px_50px_rgba(16,185,129,0.12)] hover:shadow-[0_25px_60px_rgba(16,185,129,0.2)] transition-all">
          <div class="flex items-center justify-between mb-2.5">
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="caption-mono text-[11px] font-bold text-emerald-600 uppercase tracking-wider">AI Chatbot Avatars</span>
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 bg-emerald-50 text-emerald-700 rounded-md border border-emerald-200">Step 1 / 4</span>
          </div>
          <h3 class="text-lg sm:text-2xl font-extrabold text-gray-900 tracking-tight leading-snug mb-2">
            Conversational Avatars
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-3.5 font-normal">
            Interactive, human-like AI chatbot avatars that engage website visitors, answer queries instantly, and turn interactions into qualified conversions.
          </p>
          <div class="flex flex-wrap gap-1.5 text-[11px] font-medium text-emerald-800">
            <span class="px-2.5 py-1 bg-emerald-50/90 rounded-full border border-emerald-200">🤖 Multi-Modal AI</span>
            <span class="px-2.5 py-1 bg-emerald-50/90 rounded-full border border-emerald-200">⚡ Instant Response</span>
            <span class="px-2.5 py-1 bg-emerald-50/90 rounded-full border border-emerald-200">💬 Lead Capture</span>
          </div>
        </div>
      </div>

      <!-- STAGE 2: CALLINGO AGENT (RIGHT SIDE - ELECTRIC BLUE THEME) -->
      <div 
        id="scroll-stage-2" 
        class="absolute right-3 sm:right-6 lg:left-auto lg:right-10 top-[38%] sm:top-[42%] md:top-[45%] -translate-y-1/2 max-w-[290px] sm:max-w-[350px] md:max-w-[380px] w-full pointer-events-auto transition-all duration-300"
        style="opacity: 0; transform: translateY(40px);"
      >
        <div class="p-4 sm:p-6 bg-white/95 backdrop-blur-xl rounded-2xl border border-blue-200/90 shadow-[0_20px_50px_rgba(59,130,246,0.12)] hover:shadow-[0_25px_60px_rgba(59,130,246,0.2)] transition-all">
          <div class="flex items-center justify-between mb-2.5">
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-blue-500"></span>
              </span>
              <span class="caption-mono text-[11px] font-bold text-blue-600 uppercase tracking-wider">Voice & Phone AI</span>
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 bg-blue-50 text-blue-700 rounded-md border border-blue-200">Step 2 / 4</span>
          </div>
          <h3 class="text-lg sm:text-2xl font-extrabold text-gray-900 tracking-tight leading-snug mb-2">
            Callingo Agent
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-3.5 font-normal">
            Autonomous voice agent placing and answering phone calls with ultra-low latency, dynamic voice pitch, appointment scheduling, and CRM logging.
          </p>
          <!-- Call UI Audio Wave Widget -->
          <div class="bg-blue-950 text-white p-3 rounded-xl border border-blue-800 flex items-center justify-between shadow-inner">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="text-xs font-semibold">Callingo Active Call</div>
                <div class="text-[10px] text-cyan-300 flex items-center gap-1 font-mono">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                  Active Voice · 00:42
                </div>
              </div>
            </div>
            <div class="flex items-center gap-1 h-5">
              <span class="w-1 h-3 bg-cyan-400 rounded-full animate-bounce"></span>
              <span class="w-1 h-5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.15s]"></span>
              <span class="w-1 h-2.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.3s]"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 3: AI-AGENT WORKFLOW (LEFT SIDE - DEEP PURPLE THEME) -->
      <div 
        id="scroll-stage-3" 
        class="absolute left-3 sm:left-6 lg:left-10 top-[38%] sm:top-[42%] md:top-[45%] -translate-y-1/2 max-w-[290px] sm:max-w-[350px] md:max-w-[380px] w-full pointer-events-auto transition-all duration-300"
        style="opacity: 0; transform: translateY(40px);"
      >
        <div class="p-4 sm:p-6 bg-white/95 backdrop-blur-xl rounded-2xl border border-purple-200/90 shadow-[0_20px_50px_rgba(139,92,246,0.12)] hover:shadow-[0_25px_60px_rgba(139,92,246,0.2)] transition-all">
          <div class="flex items-center justify-between mb-2.5">
            <div class="flex items-center gap-2">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-purple-500"></span>
              </span>
              <span class="caption-mono text-[11px] font-bold text-purple-600 uppercase tracking-wider">Automated Pipelines</span>
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 bg-purple-50 text-purple-700 rounded-md border border-purple-200">Step 3 / 4</span>
          </div>
          <h3 class="text-lg sm:text-2xl font-extrabold text-gray-900 tracking-tight leading-snug mb-2">
            AI-Agent Workflow
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-3.5 font-normal">
            Multi-agent networks executing autonomous, end-to-end tasks across software repos, databases, APIs, and customer touchpoints without manual friction.
          </p>
          <!-- Workflow Pipeline Node Graphic -->
          <div class="space-y-1.5 text-[11px]">
            <div class="p-2 bg-purple-50/90 rounded-lg border border-purple-200 flex items-center justify-between text-purple-950 font-medium">
              <span class="flex items-center gap-1.5">⚡ Trigger: Customer Signal</span>
              <span class="text-[10px] text-purple-700 font-mono">Automated</span>
            </div>
            <div class="p-2 bg-purple-50/50 rounded-lg border border-purple-100 flex items-center justify-between text-purple-900">
              <span class="flex items-center gap-1.5">🔄 Execute Callingo Voice Agent</span>
              <span class="text-[10px] text-emerald-600 font-semibold font-mono">Done</span>
            </div>
            <div class="p-2 bg-purple-50/50 rounded-lg border border-purple-100 flex items-center justify-between text-purple-900">
              <span class="flex items-center gap-1.5">📊 Update CRM & Trigger Email</span>
              <span class="text-[10px] text-blue-600 font-semibold font-mono">Synced</span>
            </div>
          </div>
        </div>
      </div>

      <!-- STAGE 4: BUILT TO SUPPORT HUMANS NOT REPLACE THEM + VIDEO PLAYBOX (RIGHT SIDE - WARM AMBER THEME) -->
      <div 
        id="scroll-stage-4" 
        class="absolute right-3 sm:right-5 lg:left-auto lg:right-8 top-[32%] sm:top-[36%] md:top-[40%] -translate-y-1/2 max-w-[310px] sm:max-w-[370px] md:max-w-[410px] w-full pointer-events-auto transition-all duration-300"
        style="opacity: 0; transform: translateY(40px);"
      >
        <div class="p-4 sm:p-5 md:p-6 bg-white/95 backdrop-blur-xl rounded-2xl border border-amber-200/90 shadow-[0_20px_50px_rgba(245,158,11,0.12)] hover:shadow-[0_25px_60px_rgba(245,158,11,0.2)] transition-all">
          
          <div class="flex items-center justify-between mb-2.5">
            <!-- Badge -->
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-amber-50 rounded-full border border-amber-200 text-[11px] font-bold text-amber-700">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
              Human Centric AI
            </div>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 bg-amber-50 text-amber-800 rounded-md border border-amber-200">Step 4 / 4</span>
          </div>

          <!-- Heading -->
          <h2 class="text-base sm:text-xl md:text-2xl font-extrabold text-gray-900 tracking-tight leading-snug mb-2">
            Built to Support Humans Not Replace Them.
          </h2>

          <!-- Short Description -->
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed mb-3 font-normal">
            Supercharging teams with AI force multipliers that handle routine operations, giving your workforce the bandwidth to innovate and lead.
          </p>

          <!-- Interactive Video Playbox (Click to play demo) -->
          <div 
            id="video-playbox-trigger" 
            class="group relative w-full h-36 sm:h-44 rounded-xl overflow-hidden cursor-pointer border border-amber-900/60 bg-gray-950 shadow-2xl transition-transform duration-300 hover:scale-[1.02]"
            role="button"
            tabindex="0"
            aria-label="Play Digital Employees Demo Video"
          >
            <!-- Background Gradient Thumbnail -->
            <div class="absolute inset-0 bg-gradient-to-tr from-gray-950 via-amber-950/40 to-slate-950 flex items-center justify-center">
              <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
              <div class="absolute -top-10 -right-10 w-28 h-28 bg-amber-500/20 rounded-full blur-xl"></div>
              <div class="absolute -bottom-10 -left-10 w-28 h-28 bg-amber-600/20 rounded-full blur-xl"></div>
              
              <!-- Thumbnail Label -->
              <div class="relative z-10 text-center px-4">
                <div class="text-[10px] font-mono tracking-widest text-amber-400 uppercase mb-1">Interactive Video Demo</div>
                <div class="text-xs sm:text-sm font-bold text-white group-hover:text-amber-200 transition-colors">Click to Watch Platform Demo</div>
              </div>
            </div>

            <!-- Dark Overlay -->
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/25 transition-colors"></div>

            <!-- Play Button with Pulsing Ripple -->
            <div class="absolute inset-0 flex items-center justify-center z-20">
              <div class="relative flex items-center justify-center">
                <span class="absolute inline-flex h-14 w-14 rounded-full bg-amber-400/30 animate-ping opacity-75"></span>
                <div class="relative w-12 h-12 rounded-full bg-amber-500 text-gray-950 flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-5 h-5 fill-current text-gray-950 translate-x-0.5" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Video Player Status Badge -->
            <div class="absolute bottom-2 left-2.5 right-2.5 z-20 flex items-center justify-between text-[10px] text-white/90">
              <span class="flex items-center gap-1 bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Watch Demo
              </span>
              <span class="bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm font-mono text-[10px]">1:45 HD</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- MOUSE SCROLL ANIMATION (BOTTOM RIGHT CORNER) -->
    <div 
      id="mouse-scroll-indicator" 
      class="absolute bottom-5 right-5 sm:bottom-7 sm:right-8 z-50 flex items-center gap-2.5 px-3.5 py-2 bg-white/95 backdrop-blur-md rounded-full border border-gray-300 shadow-vercel-float pointer-events-auto transition-all duration-300 hover:scale-105 cursor-pointer"
      title="Scroll down to explore"
    >
      <!-- Animated Mouse Outline & Wheel -->
      <div class="relative w-5 h-8 rounded-full border-2 border-gray-800 flex justify-center p-1">
        <div class="w-1 h-2 bg-gray-900 rounded-full animate-mouse-wheel"></div>
      </div>
      <span class="text-[11px] font-mono font-bold tracking-wider text-gray-800 uppercase">Scroll</span>
    </div>

    <!-- Step Indicator Dots (Right Side Vertical Visual Dots - Colored per service) -->
    <div class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-50 hidden lg:flex flex-col items-center gap-3">
      <button id="dot-step-1" class="w-3.5 h-3.5 rounded-full bg-gray-300 border border-gray-400 transition-all duration-300 cursor-pointer hover:scale-125" title="Jump to Step 1: AI Chatbot Avatars (Left)"></button>
      <button id="dot-step-2" class="w-3.5 h-3.5 rounded-full bg-gray-300 border border-gray-400 transition-all duration-300 cursor-pointer hover:scale-125" title="Jump to Step 2: Callingo Agent (Right)"></button>
      <button id="dot-step-3" class="w-3.5 h-3.5 rounded-full bg-gray-300 border border-gray-400 transition-all duration-300 cursor-pointer hover:scale-125" title="Jump to Step 3: AI-Agent Workflow (Left)"></button>
      <button id="dot-step-4" class="w-3.5 h-3.5 rounded-full bg-gray-300 border border-gray-400 transition-all duration-300 cursor-pointer hover:scale-125" title="Jump to Step 4: Built to Support Humans (Right)"></button>
    </div>

  </div>

  <!-- VIDEO DEMO INTERACTIVE MODAL -->
  <div 
    id="video-demo-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 px-4"
  >
    <div class="relative w-full max-w-4xl bg-gray-950 rounded-2xl border border-gray-800 shadow-2xl overflow-hidden">
      <!-- Modal Top Bar -->
      <div class="px-5 py-3.5 bg-gray-900 border-b border-gray-800 flex items-center justify-between text-white">
        <div class="flex items-center gap-2.5">
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span class="text-xs sm:text-sm font-semibold">Digital Employees Demo — Autonomous AI Workforce Platform</span>
        </div>
        <button 
          id="close-video-modal" 
          class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-gray-800 transition-all text-lg font-bold"
          aria-label="Close Video Modal"
        >
          ✕
        </button>
      </div>

      <!-- Modal Video Player Container -->
      <div class="relative aspect-video bg-black flex items-center justify-center">
        <video 
          id="demo-video-player"
          controls 
          class="w-full h-full object-contain"
          poster="/Herosection-image.png"
        >
          <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>

</section>

<style>
  @keyframes mouseWheel {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .animate-mouse-wheel {
    animation: mouseWheel 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
</style>

<script>
  import gsap from 'gsap';

  function initHeroStorytellingScroll() {
    const scrollWrapper = document.getElementById('hero-scroll-wrapper');
    const stickyViewport = document.getElementById('hero-sticky-viewport');
    const headerText = document.getElementById('hero-header-text');
    const avatarContainer = document.getElementById('hero-avatar-container');
    const avatarImage = document.getElementById('hero-avatar-image');
    const watermark = document.getElementById('hero-watermark');
    const mouseScrollIndicator = document.getElementById('mouse-scroll-indicator');

    // Stages
    const stage1 = document.getElementById('scroll-stage-1');
    const stage2 = document.getElementById('scroll-stage-2');
    const stage3 = document.getElementById('scroll-stage-3');
    const stage4 = document.getElementById('scroll-stage-4');

    // Dots
    const dot1 = document.getElementById('dot-step-1');
    const dot2 = document.getElementById('dot-step-2');
    const dot3 = document.getElementById('dot-step-3');
    const dot4 = document.getElementById('dot-step-4');

    // Modal Video elements
    const playboxTrigger = document.getElementById('video-playbox-trigger');
    const videoModal = document.getElementById('video-demo-modal');
    const closeModalBtn = document.getElementById('close-video-modal');
    const videoPlayer = document.getElementById('demo-video-player') as HTMLVideoElement | null;

    if (!scrollWrapper || !stickyViewport) return;

    // 1. Interactive 3D tilt on hero avatar image
    if (avatarImage) {
      document.addEventListener('mousemove', (e) => {
        const rect = avatarImage.getBoundingClientRect();
        if (rect.width === 0) return;
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;

        gsap.to(avatarImage, {
          rotateY: x * 10,
          rotateX: -y * 10,
          duration: 0.5,
          ease: 'power2.out',
          transformPerspective: 1000,
          overwrite: 'auto'
        });
      });
    }

    // 2. Video Modal Controls
    if (playboxTrigger && videoModal && closeModalBtn) {
      playboxTrigger.addEventListener('click', () => {
        videoModal.classList.remove('opacity-0', 'pointer-events-none');
        videoModal.classList.add('opacity-100', 'pointer-events-auto');
        if (videoPlayer) {
          videoPlayer.play().catch(() => {});
        }
      });

      playboxTrigger.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          playboxTrigger.click();
        }
      });

      const hideModal = () => {
        videoModal.classList.add('opacity-0', 'pointer-events-none');
        videoModal.classList.remove('opacity-100', 'pointer-events-auto');
        if (videoPlayer) {
          videoPlayer.pause();
        }
      };

      closeModalBtn.addEventListener('click', hideModal);
      videoModal.addEventListener('click', (e) => {
        if (e.target === videoModal) hideModal();
      });
    }

    // 3. Dot & Mouse Indicator Jump Click Listeners (Jumps 100vh steps)
    function scrollToStep(stepIndex: number) {
      if (!scrollWrapper) return;
      const wrapperTop = scrollWrapper.getBoundingClientRect().top + window.scrollY;
      const targetY = wrapperTop + stepIndex * window.innerHeight;
      window.scrollTo({ top: targetY, behavior: 'smooth' });
    }

    if (dot1) dot1.addEventListener('click', () => scrollToStep(0.1));
    if (dot2) dot2.addEventListener('click', () => scrollToStep(1.1));
    if (dot3) dot3.addEventListener('click', () => scrollToStep(2.1));
    if (dot4) dot4.addEventListener('click', () => scrollToStep(3.1));

    if (mouseScrollIndicator) {
      mouseScrollIndicator.addEventListener('click', () => scrollToStep(0.2));
    }

    // 4. Guaranteed Sticky Viewport & 100vh Alternating Scroll Engine
    let isTicking = false;

    function renderScrollProgress() {
      if (!scrollWrapper || !stickyViewport) return;

      const vh = window.innerHeight || 1;
      const wrapperRect = scrollWrapper.getBoundingClientRect();
      const currentScroll = Math.max(0, -wrapperRect.top);

      // GUARANTEED STICKY PINNING REINFORCEMENT:
      if (wrapperRect.top <= 0 && wrapperRect.bottom >= vh) {
        stickyViewport.style.position = 'fixed';
        stickyViewport.style.top = '0px';
        stickyViewport.style.left = '0px';
        stickyViewport.style.width = '100%';
        stickyViewport.style.height = '100vh';
      } else if (wrapperRect.bottom < vh) {
        stickyViewport.style.position = 'absolute';
        stickyViewport.style.top = `${wrapperRect.height - vh}px`;
        stickyViewport.style.left = '0px';
        stickyViewport.style.width = '100%';
        stickyViewport.style.height = '100vh';
      } else {
        stickyViewport.style.position = 'absolute';
        stickyViewport.style.top = '0px';
        stickyViewport.style.left = '0px';
        stickyViewport.style.width = '100%';
        stickyViewport.style.height = '100vh';
      }

      // A. Main Header Text fades out in the first 0.6 vh of scroll
      if (headerText) {
        const headerOpacity = Math.max(1 - (currentScroll / (0.6 * vh)), 0);
        const headerY = -Math.min(currentScroll, 0.6 * vh) * 0.4;
        gsap.to(headerText, {
          opacity: headerOpacity,
          y: headerY,
          duration: 0.2,
          ease: 'power1.out',
          overwrite: 'auto'
        });
      }

      // B. Mouse Scroll Indicator Fades out cleanly on initial scroll
      if (mouseScrollIndicator) {
        const mouseOpacity = Math.max(1 - (currentScroll / (0.8 * vh)), 0);
        gsap.to(mouseScrollIndicator, {
          opacity: mouseOpacity,
          duration: 0.2,
          ease: 'power1.out',
          overwrite: 'auto'
        });
      }

      // C. Watermark & Avatar scaling
      if (watermark) {
        gsap.to(watermark, {
          y: (currentScroll / (4 * vh)) * 60,
          scale: 1 + (currentScroll / (4 * vh)) * 0.05,
          duration: 0.2,
          ease: 'power1.out',
          overwrite: 'auto'
        });
      }

      if (avatarContainer) {
        gsap.to(avatarContainer, {
          scale: 1 + Math.min(currentScroll / (4 * vh), 1) * 0.03,
          duration: 0.2,
          ease: 'power1.out',
          overwrite: 'auto'
        });
      }

      // Helper function for 100vh Step Card animation
      function update100vhStep(
        stageEl: HTMLElement | null,
        dotEl: HTMLElement | null,
        startVh: number,
        endVh: number,
        activeDotClass: string
      ) {
        if (!stageEl) return;

        let opacity = 0;
        let translateY = 40;

        if (currentScroll >= startVh && currentScroll < startVh + 0.25 * vh) {
          // Fade IN from bottom
          const p = (currentScroll - startVh) / (0.25 * vh);
          opacity = p;
          translateY = 40 * (1 - p);
        } else if (currentScroll >= startVh + 0.25 * vh && currentScroll <= endVh - 0.25 * vh) {
          // Fully active
          opacity = 1;
          translateY = 0;
        } else if (currentScroll > endVh - 0.25 * vh && currentScroll <= endVh) {
          // Exit UP
          const p = (currentScroll - (endVh - 0.25 * vh)) / (0.25 * vh);
          opacity = 1 - p;
          translateY = -90 * p; // Goes UP!
        } else if (currentScroll > endVh) {
          // Gone above
          opacity = 0;
          translateY = -90;
        }

        gsap.to(stageEl, {
          opacity: opacity,
          y: translateY,
          duration: 0.2,
          ease: 'power1.out',
          overwrite: 'auto'
        });

        // Highlight step dot with service specific theme color
        if (dotEl) {
          const isActive = currentScroll >= startVh && currentScroll < endVh;
          if (isActive) {
            dotEl.className = `w-3.5 h-3.5 rounded-full transition-all duration-300 cursor-pointer scale-125 ${activeDotClass}`;
          } else {
            dotEl.className = 'w-3.5 h-3.5 rounded-full bg-gray-300 border border-gray-400 transition-all duration-300 cursor-pointer hover:scale-125';
          }
        }
      }

      // 4 STEPS (100vh per step) WITH THEME COLORS & ALTERNATING LEFT/RIGHT:
      // Step 1: AI Chatbot Avatars (LEFT) -> 0.0vh to 1.0vh (Emerald Green)
      update100vhStep(stage1, dot1, 0.0 * vh, 1.0 * vh, 'bg-emerald-500 border-emerald-600 shadow-md');

      // Step 2: Callingo Voice Agent (RIGHT) -> 1.0vh to 2.0vh (Electric Blue)
      update100vhStep(stage2, dot2, 1.0 * vh, 2.0 * vh, 'bg-blue-500 border-blue-600 shadow-md');

      // Step 3: AI-Agent Workflow (LEFT) -> 2.0vh to 3.0vh (Deep Purple)
      update100vhStep(stage3, dot3, 2.0 * vh, 3.0 * vh, 'bg-purple-500 border-purple-600 shadow-md');

      // Step 4: Built to Support Humans + Video Playbox (RIGHT) -> 3.0vh to 4.0vh (Warm Amber)
      update100vhStep(stage4, dot4, 3.0 * vh, 4.0 * vh, 'bg-amber-500 border-amber-600 shadow-md');

      isTicking = false;
    }

    function onScroll() {
      if (!isTicking) {
        requestAnimationFrame(renderScrollProgress);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    renderScrollProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroStorytellingScroll);
  } else {
    initHeroStorytellingScroll();
  }
</script>
