---
// HeroSection.astro - Premium Vercel-Style 3D AI Employee Hero Section
// Powered by Three.js & GSAP with unified Vercel Grid & Mesh Backdrop
---

<section id="hero-section" class="relative w-full max-w-[1400px] mx-auto overflow-hidden bg-white flex flex-col items-center justify-between select-none pt-20 sm:pt-24 pb-4 sm:pb-8 px-4 sm:px-6 lg:px-8 min-h-[calc(100vh-64px)]">
  
  <!-- VERCEL SIGNATURE UNIFIED BACKGROUND (Grid Backdrop + Soft Ambient Mesh Glow + Watermark) -->
  <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden select-none">
    <!-- Vercel Line Grid -->
    <div class="absolute inset-0 bg-grid-pattern opacity-40"></div>
    <!-- Vercel Ambient Mesh Glow -->
    <div id="hero-mesh-glow" class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] sm:w-[1100px] h-[480px] vercel-mesh-gradient opacity-35 rounded-full filter blur-[60px]"></div>
    
    <!-- DIGITAL EMPLOYEES LOW OPACITY WATERMARK (2 LINES - RESPONSIVE - NO OVERFLOW) -->
    <div id="hero-watermark" class="absolute top-[48%] sm:top-[52%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-full flex flex-col items-center justify-center pointer-events-none select-none opacity-[0.035] sm:opacity-[0.045] px-4 overflow-hidden">
      <span class="block text-[14vw] sm:text-[12vw] md:text-[10vw] lg:text-[9.5vw] font-black uppercase tracking-tighter sm:tracking-normal text-black leading-[0.82] text-center max-w-full">
        Digital
      </span>
      <span class="block text-[14vw] sm:text-[12vw] md:text-[10vw] lg:text-[9.5vw] font-black uppercase tracking-tighter sm:tracking-normal text-black leading-[0.82] text-center max-w-full">
        Employees
      </span>
    </div>

    <!-- Linear Gradient Fade to White at Bottom -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white"></div>
  </div>

  <!-- 1. HEADER TEXT (2 LINES ONLY - GRAY COLOR - PARALLAX DRIFT UP ON SCROLL) -->
  <div class="relative z-20 w-full max-w-4xl mx-auto flex flex-col items-center text-center pointer-events-none mb-3 sm:mb-5">
    
    <!-- Large Centered Heading - Exactly 2 Lines in Gray Color -->
    <h1 
      id="hero-heading" 
      class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.08] max-w-4xl mx-auto pointer-events-auto opacity-0 translate-y-8"
    >
      <span class="block text-gray-500">Meet the AI Workforce</span>
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-gray-400 via-gray-500 to-gray-600">
        That Never Stops Working
      </span>
    </h1>

    <!-- Small Description -->
    <p 
      id="hero-desc" 
      class="mt-4 sm:mt-5 text-base sm:text-lg md:text-xl text-gray-500 max-w-[680px] mx-auto font-medium tracking-tight leading-relaxed pointer-events-auto opacity-0 translate-y-6"
    >
      Intelligent AI employees that chat, call and automate your business 24/7.
    </p>

  </div>

  <!-- 2. HERO SECTION IMAGE (ENLARGED PROMINENT CENTERSTAGE IMAGE) -->
  <div class="relative z-30 w-full max-w-4xl flex items-end justify-center mt-auto mb-0 pt-2">
    
    <!-- CENTER HERO AVATAR IMAGE CONTAINER -->
    <div id="hero-avatar-container" class="relative z-30 w-full max-w-3xl h-auto pointer-events-auto flex items-center justify-center opacity-0 scale-[0.95]">
      <img 
        id="hero-avatar-image"
        src="/Herosection-image.png" 
        alt="Digital Employees Autonomous AI Workforce Platform" 
        class="w-full h-auto max-h-[520px] sm:max-h-[620px] object-contain drop-shadow-[0_25px_50px_rgba(0,0,0,0.12)] select-none transition-transform duration-300 ease-out"
        loading="eager"
        decoding="async"
      />
    </div>

  </div>

</section>

<script>
  import gsap from 'gsap';

  function initHeroSection() {
    const container = document.getElementById('hero-avatar-container');
    const image = document.getElementById('hero-avatar-image');
    const heading = document.getElementById('hero-heading');
    const desc = document.getElementById('hero-desc');
    const watermark = document.getElementById('hero-watermark');
    const meshGlow = document.getElementById('hero-mesh-glow');
    const heroSection = document.getElementById('hero-section');

    if (!container) return;

    // 1. Interactive Subtle 3D Tilt on Mouse Move
    let mouseX = 0;
    let mouseY = 0;

    if (heroSection && image) {
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        
        mouseX = x;
        mouseY = y;

        gsap.to(image, {
          rotateY: mouseX * 14,
          rotateX: -mouseY * 14,
          duration: 0.5,
          ease: 'power2.out',
          transformPerspective: 1000,
          overwrite: 'auto'
        });
      });

      heroSection.addEventListener('mouseleave', () => {
        gsap.to(image, {
          rotateY: 0,
          rotateX: 0,
          duration: 0.8,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });
    }

    // 2. GSAP Entrance Animation Timeline (<1.6s)
    const masterTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    masterTl
      .to('#main-nav', { y: 0, opacity: 1, duration: 0.5 })
      .to('#hero-heading', { y: 0, opacity: 1, duration: 0.6 }, '-=0.35')
      .to('#hero-desc', { y: 0, opacity: 1, duration: 0.5 }, '-=0.4')
      .to('#hero-avatar-container', { scale: 1, opacity: 1, duration: 0.8 }, '-=0.5');

    // 3. Smooth Multi-Layer Parallax Scroll Physics Engine
    let currentScroll = 0;
    let targetScroll = 0;
    let isTicking = false;

    function updateParallax() {
      const scrollY = targetScroll;
      const heroHeight = window.innerHeight * 0.85;
      const progress = Math.min(Math.max(scrollY / (heroHeight || 1), 0), 1);

      // Smooth Interpolation Durations (Power1.out for ultra-silky motion)
      
      // A. Heading & Description drift UP cleanly & fade out
      if (heading) {
        gsap.to(heading, { 
          y: -scrollY * 0.42, 
          opacity: Math.max(1 - progress * 1.35, 0), 
          duration: 0.4, 
          ease: 'power1.out', 
          overwrite: 'auto' 
        });
      }
      if (desc) {
        gsap.to(desc, { 
          y: -scrollY * 0.32, 
          opacity: Math.max(1 - progress * 1.45, 0), 
          duration: 0.4, 
          ease: 'power1.out', 
          overwrite: 'auto' 
        });
      }

      // B. Watermark drifts DOWN at lower parallax rate & scales slightly
      if (watermark) {
        gsap.to(watermark, { 
          y: scrollY * 0.22, 
          scale: 1 + progress * 0.06,
          opacity: (1 - progress * 0.8) * (window.innerWidth >= 640 ? 0.045 : 0.035), 
          duration: 0.4, 
          ease: 'power1.out', 
          overwrite: 'auto' 
        });
      }

      // C. Mesh Glow ambient drift
      if (meshGlow) {
        gsap.to(meshGlow, { 
          y: scrollY * 0.15, 
          duration: 0.5, 
          ease: 'power1.out', 
          overwrite: 'auto' 
        });
      }

      // D. Hero Avatar image subtle zoom & translation on scroll
      gsap.to(container, { 
        scale: 1 + progress * 0.12, 
        y: scrollY * 0.06, 
        duration: 0.4, 
        ease: 'power1.out', 
        overwrite: 'auto' 
      });

      isTicking = false;
    }

    function onScroll() {
      targetScroll = window.scrollY || window.pageYOffset || 0;
      if (!isTicking) {
        requestAnimationFrame(updateParallax);
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Initialize on DOM Ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSection);
  } else {
    initHeroSection();
  }
</script>




