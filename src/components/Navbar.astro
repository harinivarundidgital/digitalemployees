---
// Header for Digital Employees (digitalemployees.us)
// Features animated right-side icon trigger & right side slide-out drawer panel
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 w-full border-b border-[#ebebeb]/80 glass-header transition-all duration-300">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Left: Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Digital Employees Homepage">
      <div class="w-7 h-7 bg-[#171717] rounded-lg flex items-center justify-center text-white transition-transform duration-200 group-hover:scale-105 shadow-xs">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-white">
          <path d="M12 2L2 22H22L12 2Z" fill="currentColor" />
        </svg>
      </div>
      <span class="font-bold text-base tracking-[-0.4px] text-[#171717]">
        Digital Employees
      </span>
    </a>

    <!-- Right: Menu Icon Trigger Only -->
    <div class="flex items-center gap-3">
      <!-- Right Side Menu Icon Trigger Button (Visible on all screen sizes) -->
      <button 
        id="menu-toggle-btn"
        class="relative z-50 p-2.5 rounded-xl text-[#171717] hover:bg-[#f5f5f5] active:scale-95 transition-all duration-200 focus:outline-none flex items-center justify-center group border border-transparent hover:border-[#ebebeb]"
        aria-label="Toggle Navigation Menu"
        aria-expanded="false"
      >
        <svg 
          id="menu-icon-svg"
          xmlns="http://www.w3.org/2000/svg" 
          width="22" 
          height="22" 
          fill="currentColor" 
          viewBox="0 0 256 256"
          class="transition-transform duration-300 ease-in-out transform origin-center text-[#171717]"
        >
          <path d="M122.34,109.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0,0-11.32l-40-40a8,8,0,0,0-11.32,0l-40,40a8,8,0,0,0,0,11.32ZM128,35.31,156.69,64,128,92.69,99.31,64Zm5.66,111a8,8,0,0,0-11.32,0l-40,40a8,8,0,0,0,0,11.32l40,40a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0,0-11.32ZM128,220.69,99.31,192,128,163.31,156.69,192Zm109.66-98.35-40-40a8,8,0,0,0-11.32,0l-40,40a8,8,0,0,0,0,11.32l40,40a8,8,0,0,0,11.32,0l40-40A8,8,0,0,0,237.66,122.34ZM192,156.69,163.31,128,192,99.31,220.69,128Zm-82.34-34.35-40-40a8,8,0,0,0-11.32,0l-40,40a8,8,0,0,0,0,11.32l40,40a8,8,0,0,0,11.32,0l40-40A8,8,0,0,0,109.66,122.34ZM64,156.69,35.31,128,64,99.31,92.69,128Z"></path>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Backdrop Blur Overlay -->
<div 
  id="drawer-overlay" 
  class="fixed inset-0 bg-black/25 backdrop-blur-xs z-40 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<!-- Full-Height Right Side Drawer Panel -->
<aside 
  id="right-drawer"
  class="fixed top-0 right-0 bottom-0 h-screen w-80 sm:w-96 bg-white border-l border-[#ebebeb] shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between p-6 overflow-y-auto"
>
  <div class="space-y-6">
    <!-- Drawer Header Branding & Close Button -->
    <div class="flex items-center justify-between pb-5 border-b border-[#ebebeb]">
      <a href="/" class="flex items-center gap-2">
        <div class="w-6 h-6 bg-[#171717] rounded-[6px] flex items-center justify-center text-white">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="text-white">
            <path d="M12 2L2 22H22L12 2Z" fill="currentColor" />
          </svg>
        </div>
        <span class="font-bold text-sm tracking-[-0.3px] text-[#171717]">
          Digital Employees
        </span>
      </a>
      <button 
        id="drawer-close-btn" 
        class="p-1.5 text-[#737373] hover:text-[#171717] hover:bg-[#f5f5f5] rounded-lg transition-colors border border-transparent hover:border-[#ebebeb]"
        aria-label="Close menu drawer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation Label -->
    <div class="px-1">
      <p class="text-[11px] font-semibold tracking-wider text-[#888888] uppercase">Navigation</p>
    </div>

    <!-- Drawer Links List -->
    <nav class="space-y-1">
      <a href="#solutions" class="drawer-nav-item flex items-center justify-between px-3.5 py-3 text-sm font-medium text-[#171717] hover:bg-[#fafafa] rounded-xl transition-all group border border-transparent hover:border-[#ebebeb]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-[#f5f5f5] group-hover:bg-[#171717] group-hover:text-white flex items-center justify-center text-[#525252] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <span>Solutions</span>
        </div>
        <span class="text-xs text-[#888888] group-hover:translate-x-1 group-hover:text-[#171717] transition-all">→</span>
      </a>

      <a href="#how-it-works" class="drawer-nav-item flex items-center justify-between px-3.5 py-3 text-sm font-medium text-[#171717] hover:bg-[#fafafa] rounded-xl transition-all group border border-transparent hover:border-[#ebebeb]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-[#f5f5f5] group-hover:bg-[#171717] group-hover:text-white flex items-center justify-center text-[#525252] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="10 8 16 12 10 16 10 8"/>
            </svg>
          </div>
          <span>How it Works</span>
        </div>
        <span class="text-xs text-[#888888] group-hover:translate-x-1 group-hover:text-[#171717] transition-all">→</span>
      </a>

      <a href="#industries" class="drawer-nav-item flex items-center justify-between px-3.5 py-3 text-sm font-medium text-[#171717] hover:bg-[#fafafa] rounded-xl transition-all group border border-transparent hover:border-[#ebebeb]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-[#f5f5f5] group-hover:bg-[#171717] group-hover:text-white flex items-center justify-center text-[#525252] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 10v11M12 10v11M16 10v11"/>
            </svg>
          </div>
          <span>Industries</span>
        </div>
        <span class="text-xs text-[#888888] group-hover:translate-x-1 group-hover:text-[#171717] transition-all">→</span>
      </a>

      <a href="#pricing" class="drawer-nav-item flex items-center justify-between px-3.5 py-3 text-sm font-medium text-[#171717] hover:bg-[#fafafa] rounded-xl transition-all group border border-transparent hover:border-[#ebebeb]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-[#f5f5f5] group-hover:bg-[#171717] group-hover:text-white flex items-center justify-center text-[#525252] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <span>Pricing</span>
        </div>
        <span class="text-xs text-[#888888] group-hover:translate-x-1 group-hover:text-[#171717] transition-all">→</span>
      </a>

      <a href="#about" class="drawer-nav-item flex items-center justify-between px-3.5 py-3 text-sm font-medium text-[#171717] hover:bg-[#fafafa] rounded-xl transition-all group border border-transparent hover:border-[#ebebeb]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-[#f5f5f5] group-hover:bg-[#171717] group-hover:text-white flex items-center justify-center text-[#525252] transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <span>About Us</span>
        </div>
        <span class="text-xs text-[#888888] group-hover:translate-x-1 group-hover:text-[#171717] transition-all">→</span>
      </a>
    </nav>
  </div>

  <!-- Drawer Footer Actions -->
  <div class="pt-6 border-t border-[#ebebeb] space-y-3 mt-6">
    <a 
      href="#demo" 
      class="drawer-nav-item w-full h-11 flex items-center justify-center gap-2 text-xs font-semibold text-white bg-[#171717] hover:bg-[#333333] active:scale-[0.98] rounded-xl transition-all shadow-xs"
    >
      <span>Book a Demo</span>
      <span>→</span>
    </a>
    <a 
      href="#login" 
      class="drawer-nav-item w-full h-11 flex items-center justify-center text-xs font-semibold text-[#171717] bg-[#fafafa] hover:bg-[#f5f5f5] border border-[#ebebeb] rounded-xl transition-colors"
    >
      Log In
    </a>
  </div>
</aside>

<script>
  // Right Drawer & Icon Animation Logic
  const menuToggleBtn = document.getElementById('menu-toggle-btn');
  const menuIconSvg = document.getElementById('menu-icon-svg');
  const rightDrawer = document.getElementById('right-drawer');
  const drawerOverlay = document.getElementById('drawer-overlay');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');
  const drawerNavItems = document.querySelectorAll('.drawer-nav-item');

  let isOpen = false;

  function toggleMenu(open?: boolean) {
    isOpen = open !== undefined ? open : !isOpen;

    if (rightDrawer && drawerOverlay && menuIconSvg && menuToggleBtn) {
      if (isOpen) {
        // Slide drawer in from right
        rightDrawer.classList.remove('translate-x-full');
        rightDrawer.classList.add('translate-x-0');
        
        // Show backdrop overlay
        drawerOverlay.classList.remove('opacity-0', 'pointer-events-none');
        drawerOverlay.classList.add('opacity-100', 'pointer-events-auto');

        // Icon rotation & scale animation on open
        menuIconSvg.classList.add('rotate-180', 'scale-110');
        menuToggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        // Slide drawer out to right
        rightDrawer.classList.remove('translate-x-0');
        rightDrawer.classList.add('translate-x-full');

        // Hide backdrop overlay
        drawerOverlay.classList.remove('opacity-100', 'pointer-events-auto');
        drawerOverlay.classList.add('opacity-0', 'pointer-events-none');

        // Icon reverse animation on close
        menuIconSvg.classList.remove('rotate-180', 'scale-110');
        menuToggleBtn.setAttribute('aria-expanded', 'false');
      }
    }
  }

  if (menuToggleBtn) {
    menuToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });
  }

  if (drawerCloseBtn) {
    drawerCloseBtn.addEventListener('click', () => toggleMenu(false));
  }

  if (drawerOverlay) {
    drawerOverlay.addEventListener('click', () => toggleMenu(false));
  }

  drawerNavItems.forEach((item) => {
    item.addEventListener('click', () => toggleMenu(false));
  });

  // Close drawer on Escape key press
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu(false);
    }
  });
</script>

