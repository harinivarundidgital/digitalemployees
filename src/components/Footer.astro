---
// Footer component following Vercel design language specs from DESIGN.md
---

<footer class="w-full bg-white border-t border-[#ebebeb] pt-16 pb-12 text-sm text-[#4d4d4d]">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 pb-12 border-b border-[#ebebeb]">
      
      <!-- Brand & Domain Column -->
      <div class="col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-6 h-6 bg-[#171717] rounded-[5px] flex items-center justify-center text-white">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="text-white">
              <path d="M12 2L2 22H22L12 2Z" fill="currentColor" />
            </svg>
          </div>
          <span class="font-semibold text-base text-[#171717]">Digital Employees</span>
        </div>
        <p class="text-xs text-[#888888] leading-relaxed max-w-sm">
          The autonomous AI workforce platform for software engineering, operations, and enterprise security.
        </p>
        <p class="caption-mono text-xs text-[#0070f3]">
          https://digitalemployees.us
        </p>
      </div>

      <!-- Column 1: Products -->
      <div class="space-y-3">
        <h4 class="caption-mono uppercase text-xs text-[#171717] font-medium tracking-wider">Products</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#agents" class="hover:text-[#171717] transition-colors">Software Engineer Agent</a></li>
          <li><a href="#agents" class="hover:text-[#171717] transition-colors">DevOps & SRE Agent</a></li>
          <li><a href="#agents" class="hover:text-[#171717] transition-colors">Security Audit Agent</a></li>
          <li><a href="#agents" class="hover:text-[#171717] transition-colors">Data Science Agent</a></li>
          <li><a href="#agents" class="hover:text-[#171717] transition-colors">QA Automation Agent</a></li>
        </ul>
      </div>

      <!-- Column 2: Resources -->
      <div class="space-y-3">
        <h4 class="caption-mono uppercase text-xs text-[#171717] font-medium tracking-wider">Resources</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#docs" class="hover:text-[#171717] transition-colors">Documentation</a></li>
          <li><a href="#api" class="hover:text-[#171717] transition-colors">API Reference</a></li>
          <li><a href="#changelog" class="hover:text-[#171717] transition-colors">Changelog</a></li>
          <li><a href="#status" class="hover:text-[#171717] transition-colors">System Status</a></li>
          <li><a href="#benchmarks" class="hover:text-[#171717] transition-colors">SWE-bench Results</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="space-y-3">
        <h4 class="caption-mono uppercase text-xs text-[#171717] font-medium tracking-wider">Company</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#about" class="hover:text-[#171717] transition-colors">About Us</a></li>
          <li><a href="#careers" class="hover:text-[#171717] transition-colors">Careers <span class="caption-mono text-[10px] bg-[#d3e5ff] text-[#0070f3] px-1 py-0.5 rounded">Hiring</span></a></li>
          <li><a href="#security" class="hover:text-[#171717] transition-colors">Trust & Security</a></li>
          <li><a href="#privacy" class="hover:text-[#171717] transition-colors">Privacy Policy</a></li>
          <li><a href="#terms" class="hover:text-[#171717] transition-colors">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Status bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#888888]">
      <p>© {new Date().getFullYear()} Digital Employees Inc. All rights reserved. Operating on digitalemployees.us</p>
      
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#50e3c2] animate-pulse"></span>
        <span class="caption-mono text-xs text-[#171717]">All Systems Operational</span>
      </div>
    </div>

  </div>
</footer>
